// Family Recipe Box — data model
// Uses Postgres (works well with Railway/Render/Vercel-style hosting where the
// filesystem isn't persistent, unlike SQLite's single-file approach).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id           String   @id @default(cuid())
  name         String
  inviteCode   String   @unique
  createdAt    DateTime @default(now())
  shareEnabled Boolean  @default(false)
  shareToken   String   @unique @default(cuid())
  // Secret link for the family grocery list (/list/[token]). Created the first time it's needed.
  listToken    String?  @unique

  users           User[]
  recipes         Recipe[]
  tags            Tag[]
  mealPlanEntries MealPlanEntry[]
  groceryItems    GroceryItem[]
  archivedItems   ArchivedGroceryItem[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
}

model Recipe {
  id          String  @id @default(cuid())
  title       String
  sourceUrl   String?
  imageUrl    String?
  // Set when imageUrl came from an Unsplash search — required by Unsplash's
  // API guidelines to credit the photographer wherever the photo is shown.
  imageAttributionName String?
  imageAttributionUrl  String?
  description String?
  servings    Int?
  prepMinutes Int?
  cookMinutes Int?
  // Only set when a site publishes a single combined time instead of a prep/cook split
  // (e.g. NYT Cooking often only has "totalTime"). Kept separate rather than guessed
  // into prep or cook so the number shown is never misattributed.
  totalMinutes Int?

  // Stored as JSON strings (SQLite has no native array/json column):
  // ingredients: [{ raw: string, quantity: string|null, unit: string|null, item: string }]
  // instructions: [string]
  ingredientsJson  String
  instructionsJson String

  category String? // Breakfast | Lunch | Dinner | Dessert | Snack | Drink | Side | Sauce/Base
  cuisine  String? // e.g. Italian, Thai, Mexican — free text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  tags            RecipeTag[]
  mealPlanEntries MealPlanEntry[]

  @@index([householdId])
  @@index([category])
}

model Tag {
  id          String @id @default(cuid())
  name        String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  recipes     RecipeTag[]

  @@unique([householdId, name])
}

model RecipeTag {
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId    String

  @@id([recipeId, tagId])
}

model MealPlanEntry {
  id       String   @id @default(cuid())
  date     DateTime // stored at local midnight for the planned day
  mealType String // Breakfast | Lunch | Dinner | Snack
  servings Int?
  // Multiplier applied to the recipe's base ingredient quantities (0.5 = half, 2 = double, etc).
  // Used when generating a grocery list so scaled quantities carry through correctly.
  scale    Float    @default(1)

  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  createdAt DateTime @default(now())

  @@index([householdId, date])
}

model GroceryItem {
  id        String  @id @default(cuid())
  name      String
  quantity  String?
  checked   Boolean @default(false)
  // "manual" for hand-added items, or the recipeId that generated this item
  source    String  @default("manual")
  // Grocery section, e.g. "Produce", "Dairy & Eggs". Filled in automatically by Claude.
  section   String  @default("Other")
  // Where to buy it: "vons" (default), "traderjoes", "costco", or "amazon"
  store     String  @default("vons")

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  createdAt DateTime @default(now())

  @@index([householdId])
}

model ArchivedGroceryItem {
  id           String   @id @default(cuid())
  name         String
  // Lowercased, trimmed name so "Eggs" and "eggs " count as the same item
  nameKey      String
  quantity     String?
  section      String   @default("Other")
  store        String   @default("vons")
  timesBought  Int      @default(1)
  lastBoughtAt DateTime @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  @@unique([householdId, nameKey])
  @@index([householdId, timesBought])
}
