# Copy this file to .env and fill in real values before running the app.

# Postgres connection string. Locally, use the same database your production
# app uses (get this from Railway's Postgres service → "Connect" tab → the
# public connection URL). Format looks like:
# postgresql://user:password@host:port/railway
DATABASE_URL=""

# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# The URL your app is served from. For local dev, leave as-is.
NEXTAUTH_URL="http://localhost:3000"

# Optional — only needed for "Upload a screenshot" recipe import.
# Get a key at https://console.anthropic.com/settings/keys
# Leave blank/unset to disable that feature; URL import and manual entry work without it.
ANTHROPIC_API_KEY=""

# Optional — only needed for the "Find a photo" Unsplash search feature.
# Get a free key (Access Key) at https://unsplash.com/developers — create an app,
# the demo tier (50 requests/hour) is plenty for personal use.
# Leave blank/unset to disable that feature.
UNSPLASH_ACCESS_KEY=""
